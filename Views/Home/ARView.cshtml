@{
    bool isLoggedIn = ViewBag.IsLoggedIn != null && (bool)ViewBag.IsLoggedIn;
    string userName = ViewBag.UserName as string ?? "";
}

<input type="hidden" id="loginStateValue" value="@(isLoggedIn ? "true" : "false")" />

<style>
    :root {
        --orange: #ff7900;
        --dark: #1f252c;
        --muted: #6b7280;
        --soft: #fff7ef;
        --border: #ead8c2;
    }

    .ar-page {
        background: linear-gradient(135deg, #fffaf4, #f3ede6);
        min-height: 100vh;
        padding: 30px 0 55px;
        font-family: Arial, sans-serif;
    }

    .ar-container {
        width: min(1220px, 94%);
        margin: auto;
    }

    .ar-hero {
        background: linear-gradient(135deg, #1f252c, #35312c);
        color: white;
        border-radius: 28px;
        padding: 34px;
        margin-bottom: 22px;
        box-shadow: 0 18px 45px rgba(0,0,0,0.22);
        position: relative;
        overflow: hidden;
    }

        .ar-hero::after {
            content: "";
            position: absolute;
            width: 260px;
            height: 260px;
            background: rgba(255,121,0,0.22);
            border-radius: 50%;
            right: -90px;
            top: -90px;
        }

        .ar-hero h1 {
            font-size: 34px;
            font-weight: 900;
            margin: 0 0 8px;
        }

        .ar-hero p {
            max-width: 760px;
            color: #f3e3d4;
            margin: 0;
            line-height: 1.6;
            font-size: 15px;
        }

    .mode-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
        margin-bottom: 20px;
    }

    .mode-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 18px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.07);
    }

        .mode-card.active {
            border: 2px solid var(--orange);
            background: #fff8ef;
        }

        .mode-card h4 {
            font-size: 17px;
            color: var(--dark);
            font-weight: 900;
            margin: 0 0 6px;
        }

        .mode-card p {
            font-size: 13px;
            color: var(--muted);
            margin: 0;
            line-height: 1.45;
        }

    .studio-grid {
        display: grid;
        grid-template-columns: 360px 1fr;
        gap: 18px;
        align-items: start;
    }

    .panel {
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: 24px;
        box-shadow: 0 14px 38px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .panel-head {
        padding: 18px 20px;
        background: #fff7ef;
        border-bottom: 1px solid var(--border);
    }

        .panel-head h3 {
            color: var(--dark);
            font-size: 18px;
            font-weight: 900;
            margin: 0;
        }

        .panel-head p {
            color: var(--muted);
            margin: 5px 0 0;
            font-size: 13px;
            line-height: 1.4;
        }

    .panel-body {
        padding: 18px;
    }

    .btn-orange {
        background: var(--orange);
        color: white;
        border: none;
        border-radius: 14px;
        padding: 11px 14px;
        font-weight: 900;
        width: 100%;
        transition: 0.2s;
    }

        .btn-orange:hover {
            background: #e66f00;
            color: white;
            transform: translateY(-1px);
        }

    .btn-dark-soft {
        background: var(--dark);
        color: white;
        border: none;
        border-radius: 14px;
        padding: 11px 14px;
        font-weight: 900;
        width: 100%;
    }

    .btn-outline-soft {
        background: white;
        border: 1px solid var(--border);
        color: var(--dark);
        border-radius: 14px;
        padding: 10px 14px;
        font-weight: 900;
        width: 100%;
    }

    .camera-box {
        background: #15191f;
        border-radius: 18px;
        overflow: hidden;
        margin-bottom: 12px;
        min-height: 190px;
        display: grid;
        place-items: center;
        color: white;
        position: relative;
    }

    #cameraVideo {
        width: 100%;
        height: 230px;
        object-fit: cover;
        display: none;
    }

    .camera-placeholder {
        color: #e9d4bd;
        padding: 18px;
        text-align: center;
        font-weight: 800;
        line-height: 1.5;
    }

    .upload-box {
        border: 2px dashed #e6c6a2;
        background: #fffaf4;
        border-radius: 18px;
        padding: 16px;
        text-align: center;
        margin: 14px 0;
    }

        .upload-box input {
            margin-top: 10px;
            font-size: 13px;
        }

    .hint {
        background: #f7fbff;
        border: 1px solid #d8e8f5;
        color: #3c5870;
        border-radius: 16px;
        padding: 12px;
        font-size: 13px;
        line-height: 1.5;
        margin-top: 12px;
        font-weight: 700;
    }

    .library-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
        max-height: 430px;
        overflow-y: auto;
        padding-right: 4px;
    }

    .furniture-card {
        border: 1px solid var(--border);
        background: #fffdf9;
        border-radius: 16px;
        padding: 10px;
        text-align: center;
        cursor: pointer;
        transition: 0.18s;
    }

        .furniture-card:hover {
            border-color: var(--orange);
            background: #fff4e7;
            transform: translateY(-2px);
        }

        .furniture-card img {
            width: 100%;
            height: 72px;
            object-fit: contain;
            filter: drop-shadow(0 8px 8px rgba(0,0,0,0.13));
        }

        .furniture-card span {
            display: block;
            color: var(--dark);
            font-size: 12px;
            font-weight: 900;
            margin-top: 6px;
        }

    .workspace-panel {
        min-height: 760px;
    }

    .workspace-head {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: center;
        padding: 18px 20px;
        background: #ffffff;
        border-bottom: 1px solid var(--border);
    }

        .workspace-head h3 {
            margin: 0;
            font-size: 18px;
            font-weight: 900;
            color: var(--dark);
        }

    .workspace-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .small-btn {
        border: 1px solid var(--border);
        background: #fff8ef;
        color: var(--dark);
        border-radius: 12px;
        padding: 8px 11px;
        font-size: 12px;
        font-weight: 900;
    }

        .small-btn.orange {
            background: var(--orange);
            color: white;
            border-color: var(--orange);
        }

    .room-stage-wrap {
        padding: 18px;
        background: #faf6ef;
    }

    .room-stage {
        width: 100%;
        height: 610px;
        border-radius: 22px;
        background: linear-gradient(135deg, #e7ded1, #cdb99c);
        border: 2px solid #e2cfb8;
        position: relative;
        overflow: hidden;
        display: grid;
        place-items: center;
        box-shadow: inset 0 0 0 1px rgba(255,255,255,0.45);
        user-select: none;
        touch-action: none;
    }

    .room-empty {
        text-align: center;
        color: #594f43;
        padding: 25px;
        font-weight: 900;
        line-height: 1.6;
        max-width: 520px;
    }

    .room-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        background: #eee6dc;
        z-index: 1;
    }

    .placed-item {
        position: absolute;
        left: 40%;
        top: 52%;
        width: 190px;
        height: auto;
        z-index: 5;
        cursor: move;
        touch-action: none;
        transform-origin: center center;
    }

        .placed-item.selected {
            outline: 2px dashed var(--orange);
            outline-offset: 5px;
            border-radius: 10px;
        }

        .placed-item img {
            width: 100%;
            display: block;
            pointer-events: none;
            filter: drop-shadow(0 16px 14px rgba(0,0,0,0.22));
        }

    .item-tag {
        position: absolute;
        left: 50%;
        bottom: -30px;
        transform: translateX(-50%);
        background: rgba(31,37,44,0.88);
        color: white;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 900;
        padding: 5px 9px;
        white-space: nowrap;
        display: none;
    }

    .placed-item.selected .item-tag {
        display: block;
    }

    .controls-bar {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 8px;
        margin-top: 12px;
    }

    .control-btn {
        border: 1px solid var(--border);
        background: white;
        color: var(--dark);
        border-radius: 14px;
        padding: 10px 8px;
        font-size: 12px;
        font-weight: 900;
    }

        .control-btn.danger {
            background: #fff1f1;
            color: #b91c1c;
            border-color: #ffd4d4;
        }

        .control-btn:disabled {
            opacity: 0.45;
            cursor: not-allowed;
        }

    .status-line {
        margin-top: 12px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 11px 12px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
    }

    .login-note {
        background: #fff4e6;
        border: 1px solid #ffd1a3;
        color: #7a3d00;
        border-radius: 14px;
        padding: 12px;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .hidden-canvas {
        display: none;
    }


    .ai-chat-section {
        margin-top: 22px;
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: 24px;
        box-shadow: 0 14px 38px rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .ai-chat-grid {
        display: grid;
        grid-template-columns: 330px 1fr;
        gap: 0;
    }

    .ai-form-side {
        padding: 20px;
        border-right: 1px solid var(--border);
        background: #fffaf4;
    }

    .ai-result-side {
        padding: 20px;
    }

    .ai-label {
        display: block;
        color: var(--dark);
        font-size: 13px;
        font-weight: 900;
        margin: 12px 0 6px;
    }

    .ai-input,
    .ai-select,
    .ai-textarea {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 13px;
        padding: 11px 12px;
        font-size: 13px;
        outline: none;
        background: #ffffff;
    }

    .ai-textarea {
        min-height: 105px;
        resize: vertical;
    }

    .chat-window {
        background: #f8f3ec;
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 14px;
        height: 260px;
        overflow-y: auto;
        margin-bottom: 12px;
    }

    .chat-msg {
        max-width: 88%;
        padding: 10px 12px;
        border-radius: 16px;
        margin-bottom: 10px;
        font-size: 13px;
        line-height: 1.45;
        font-weight: 700;
    }

        .chat-msg.bot {
            background: #ffffff;
            color: #404852;
            border: 1px solid #ead8c2;
        }

        .chat-msg.user {
            background: var(--orange);
            color: #ffffff;
            margin-left: auto;
        }

    .chat-send-row {
        display: grid;
        grid-template-columns: 1fr 100px;
        gap: 8px;
        margin-bottom: 14px;
    }

    .ai-report {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .ai-report-card {
        background: #fffdf9;
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 14px;
    }

        .ai-report-card h5 {
            color: var(--orange);
            font-size: 14px;
            font-weight: 900;
            margin: 0 0 8px;
        }

        .ai-report-card p,
        .ai-report-card li {
            color: #4f5964;
            font-size: 13px;
            line-height: 1.55;
            margin-bottom: 5px;
        }

    .palette-row {
        display: flex;
        gap: 7px;
        margin-top: 8px;
    }

    .palette-dot {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: 2px solid #ffffff;
        box-shadow: 0 6px 15px rgba(0,0,0,0.15);
    }

    .ai-visual-mini {
        min-height: 150px;
        border-radius: 16px;
        border: 1px solid #ead8c2;
        background: linear-gradient(180deg, #eee7dd 0%, #faf4ed 58%, #d2b48c 59%, #c29b6f 100%);
        position: relative;
        overflow: hidden;
    }

    .mini-main {
        position: absolute;
        left: 34%;
        bottom: 30px;
        width: 32%;
        height: 45px;
        background: rgba(255,121,0,0.25);
        border: 2px solid rgba(255,121,0,0.45);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6b3500;
        font-size: 11px;
        font-weight: 900;
    }

    .mini-left,
    .mini-right {
        position: absolute;
        bottom: 34px;
        width: 20%;
        height: 34px;
        border-radius: 14px;
        background: rgba(255,255,255,0.75);
        border: 1px solid rgba(0,0,0,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 900;
        color: #4f5964;
    }

    .mini-left {
        left: 8%;
    }

    .mini-right {
        right: 8%;
    }

    .ai-download-row {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 12px;
    }





    .full-room-preview-card {
        grid-column: 1 / -1;
        background: #fffdf9;
        border: 1px solid var(--border);
        border-radius: 22px;
        padding: 16px;
        box-shadow: 0 12px 30px rgba(0,0,0,0.06);
    }

        .full-room-preview-card h5 {
            color: var(--orange);
            font-size: 16px;
            font-weight: 900;
            margin: 0 0 12px;
        }

    .full-room-photo {
        width: 100%;
        height: 430px;
        border-radius: 20px;
        object-fit: cover;
        display: block;
        border: 1px solid #e8d4bd;
        box-shadow: 0 16px 36px rgba(0,0,0,0.14);
        background: #eee7dc;
    }

    .full-room-preview-text {
        margin-top: 12px;
        color: #4f5964;
        font-size: 13px;
        line-height: 1.6;
        font-weight: 700;
    }

    .full-room-tags {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
        margin-top: 12px;
    }

    .full-room-tag {
        background: #fff8ef;
        border: 1px solid #ead8c2;
        border-radius: 15px;
        padding: 10px;
        text-align: center;
        color: #20242a;
        font-size: 12px;
        font-weight: 900;
    }

    .ai-mode-box {
        background: #f7fbff;
        border: 1px solid #d8e8f5;
        color: #3c5870;
        border-radius: 16px;
        padding: 12px;
        font-size: 13px;
        line-height: 1.5;
        margin: 12px 0;
        font-weight: 800;
    }





    .custom-chat-help {
        background: #fff7ef;
        border: 1px solid #ffd1a3;
        border-radius: 16px;
        padding: 12px;
        margin-top: 10px;
        color: #6b3b00;
        font-size: 13px;
        font-weight: 800;
        line-height: 1.55;
    }

    .chat-msg.bot.designer strong {
        color: #ff7900;
    }

    .ai-part-title {
        background: #1f252c;
        color: #ffffff;
        border-radius: 16px;
        padding: 12px 14px;
        margin-bottom: 12px;
        font-size: 14px;
        font-weight: 900;
    }

        .ai-part-title span {
            color: #ffb26b;
        }

    .chatbot-guide {
        background: #fffaf3;
        border: 1px solid #ead8c2;
        border-radius: 16px;
        padding: 12px;
        margin-bottom: 12px;
        color: #4f5964;
        font-size: 13px;
        font-weight: 800;
        line-height: 1.55;
    }

    .designer-mode-note {
        background: #fff4e6;
        border: 1px solid #ffd1a3;
        color: #6d3900;
        border-radius: 16px;
        padding: 12px;
        font-size: 13px;
        font-weight: 800;
        line-height: 1.55;
        margin: 10px 0 12px;
    }

    .chat-msg.bot.designer {
        background: #ffffff;
        border-left: 5px solid #ff7900;
        white-space: pre-line;
        max-width: 96%;
    }

    .chat-msg.user {
        white-space: pre-line;
    }

    .chat-example-box {
        background: #f7fbff;
        border: 1px solid #d8e8f5;
        color: #3c5870;
        border-radius: 16px;
        padding: 12px;
        margin-top: 12px;
        font-size: 13px;
        line-height: 1.55;
        font-weight: 800;
    }

    .designer-card-wide {
        grid-column: 1 / -1;
        background: #fffdf9;
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 16px;
    }

        .designer-card-wide h5 {
            color: var(--orange);
            font-size: 15px;
            font-weight: 900;
            margin: 0 0 10px;
        }

        .designer-card-wide p,
        .designer-card-wide li {
            color: #4f5964;
            font-size: 13px;
            line-height: 1.6;
            margin-bottom: 6px;
        }

    .ready-room-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
        margin-top: 10px;
    }

    .ready-room-btn {
        border: 1px solid #ffd1a3;
        background: #fff4e6;
        color: #7a3d00;
        border-radius: 14px;
        padding: 10px 8px;
        font-size: 12px;
        font-weight: 900;
        cursor: pointer;
        text-align: center;
    }

        .ready-room-btn:hover {
            background: var(--orange);
            color: white;
            border-color: var(--orange);
        }

    .apply-design-box {
        background: #f7fbff;
        border: 1px solid #d8e8f5;
        color: #3c5870;
        border-radius: 16px;
        padding: 12px;
        font-size: 13px;
        line-height: 1.5;
        margin-top: 12px;
        font-weight: 800;
    }

    .category-tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-bottom: 12px;
    }

    .category-tab {
        border: 1px solid var(--border);
        background: #fff8ef;
        color: var(--dark);
        border-radius: 999px;
        padding: 7px 10px;
        font-size: 11px;
        font-weight: 900;
        cursor: pointer;
    }

        .category-tab.active {
            background: var(--orange);
            color: #ffffff;
            border-color: var(--orange);
        }

    .selected-info-card {
        background: #fff8ef;
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 12px;
        margin-top: 12px;
    }

        .selected-info-card h5 {
            color: var(--orange);
            font-size: 14px;
            font-weight: 900;
            margin: 0 0 6px;
        }

        .selected-info-card p {
            color: #4f5964;
            font-size: 12px;
            font-weight: 700;
            line-height: 1.45;
            margin: 0 0 4px;
        }

    .quick-chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin: 10px 0 12px;
    }

    .quick-chip {
        border: 1px solid #ffd1a3;
        background: #fff4e6;
        color: #7a3d00;
        border-radius: 999px;
        padding: 7px 10px;
        font-size: 12px;
        font-weight: 900;
        cursor: pointer;
    }

        .quick-chip:hover {
            background: #ff7900;
            color: white;
        }


    @@media screen and (max-width: 980px) {
        .studio-grid {
            grid-template-columns: 1fr;
        }

        .mode-grid {
            grid-template-columns: 1fr;
        }

        .room-stage {
            height: 520px;
        }

        .controls-bar {
            grid-template-columns: repeat(2, 1fr);
        }

        .workspace-head {
            align-items: flex-start;
            flex-direction: column;
        }

        .ai-chat-grid {
            grid-template-columns: 1fr;
        }

        .ai-form-side {
            border-right: none;
            border-bottom: 1px solid var(--border);
        }

        .ai-report {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="ar-page">
    <div class="ar-container">
        <div class="ar-hero">
            <h1>AR Room Furniture Placement Studio</h1>
            <p>
                Capture a room photo using camera or upload a gallery image, then place multiple furniture items,
                move them, resize, rotate and download the final room design.
            </p>
        </div>

        <div class="mode-grid">
            <div class="mode-card active" onclick="openOptionOne()" style="cursor:pointer;">
                <h4>Option 1 — Camera AR Placement</h4>
                <p>Camera se room photo capture karo aur multiple furniture place karo.</p>
            </div>
            <div class="mode-card" onclick="openOptionTwo()" style="cursor:pointer;">
                <h4>Option 2 — Gallery Upload Placement</h4>
                <p>Gallery se room image upload karo aur us par furniture place karo.</p>
            </div>
            <div class="mode-card" onclick="openOptionThree()" style="cursor:pointer;">
                <h4>Option 3 — AI Chatbot Suggestions</h4>
                <p>Room type, style aur requirement ke hisaab se chatbot design suggestions dega.</p>
            </div>
        </div>

        <div class="studio-grid">
            <div class="left-tools">
                <div class="panel">
                    <div class="panel-head">
                        <h3>1. Add Room Image</h3>
                        <p>Camera se room capture karo ya gallery se image upload karo.</p>
                    </div>

                    <div class="panel-body">
                        @if (!isLoggedIn)
                        {
                            <div class="login-note">
                                Login recommended: save feature ke liye account required ho sakta hai.
                            </div>
                        }

                        <div class="camera-box">
                            <video id="cameraVideo" autoplay playsinline></video>
                            <div class="camera-placeholder" id="cameraPlaceholder">
                                Camera preview yahan show hoga.
                            </div>
                        </div>

