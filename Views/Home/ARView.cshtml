    let cameraStream = null;
    let selectedItem = null;
    let itemCounter = 0;
    let highestZ = 10;
    let hasRoomImage = false;
    let currentRoomSet = "all";

    document.addEventListener("DOMContentLoaded", function () {
        renderFurnitureLibrary();
        setStatus("Ready. Add room image from camera or gallery.");
    });

    function getFurnitureSrc(item) {
        return item.path || ("/images/ar-furniture/" + item.file);
    }

    function renderFurnitureLibrary() {
        const library = document.getElementById("furnitureLibrary");
        library.innerHTML = "";

        const filteredItems = currentRoomSet === "all"
            ? furnitureItems.filter(item => item.roomSet === "all")
            : furnitureItems.filter(item => item.roomSet === currentRoomSet);

        filteredItems.forEach(item => {
            const card = document.createElement("div");
            card.className = "furniture-card";
            card.onclick = function () {
                updateSelectedInfo(item);
                addFurnitureToRoom(item);
            };

            card.innerHTML =
                "<img src='" + getFurnitureSrc(item) + "' alt='" + item.name + "' onerror='this.style.opacity=0.25; this.alt=\"Image Missing\"' />" +
                "<span>" + item.name + "</span>";

            library.appendChild(card);
        });
    }

    function selectRoomSet(roomSet, btn) {
        currentRoomSet = roomSet;

        document.querySelectorAll(".category-tab").forEach(tab => tab.classList.remove("active"));

        if (btn) {
            btn.classList.add("active");
        }

        renderFurnitureLibrary();

        const name = roomSet === "all" ? "All Common Furniture" : roomSet.replaceAll("-", " ");
        setStatus("Room set selected: " + name + ". Ab is folder ki items show ho rahi hain.");
    }

    function filterFurniture(category, btn) {
        selectRoomSet(category, btn);
    }

    function updateSelectedInfo(item) {
        const box = document.getElementById("selectedInfoCard");

        if (!box) return;

        box.innerHTML =
            "<h5>" + item.name + "</h5>" +
            "<p><strong>Category:</strong> " + item.category + "</p>" +
            "<p><strong>Use:</strong> " + item.use + "</p>" +
            "<p><strong>Placement Tip:</strong> " + item.tip + "</p>";
    }

    function setStatus(message) {
        const status = document.getElementById("statusLine");
        if (status) {
            status.innerText = message;
        }
    }

    async function startCamera() {
        try {
            const video = document.getElementById("cameraVideo");
            const placeholder = document.getElementById("cameraPlaceholder");

            cameraStream = await navigator.mediaDevices.getUserMedia({
                video: { facingMode: "environment" },
                audio: false
            });

            video.srcObject = cameraStream;
            video.style.display = "block";
            placeholder.style.display = "none";

            setStatus("Camera opened. Point camera towards room and click Capture.");
        } catch (error) {
            setStatus("Camera could not open. Please use Upload From Gallery option.");
            alert("Camera permission denied or unavailable. Please upload room image from gallery.");
        }
    }

    function stopCamera() {
        if (cameraStream) {
            cameraStream.getTracks().forEach(track => track.stop());
            cameraStream = null;
        }

        const video = document.getElementById("cameraVideo");
        const placeholder = document.getElementById("cameraPlaceholder");

        video.style.display = "none";
        placeholder.style.display = "block";

        setStatus("Camera stopped.");
    }

    function captureRoomPhoto() {
        const video = document.getElementById("cameraVideo");

        if (!cameraStream || video.videoWidth === 0) {
            alert("Please open camera first.");
            return;
        }

        const canvas = document.createElement("canvas");
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;

        const ctx = canvas.getContext("2d");
        ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

        setRoomBackground(canvas.toDataURL("image/png"));
        setStatus("Room photo captured. Now add furniture from library.");
    }

    function uploadRoomImage(event) {
        const file = event.target.files[0];

        if (!file) return;

        const reader = new FileReader();

        reader.onload = function (e) {
            setRoomBackground(e.target.result);
            setStatus("Gallery room image uploaded. Now add furniture from library.");
        };

        reader.readAsDataURL(file);
    }

    function setRoomBackground(src) {
        const bg = document.getElementById("roomBackground");
        const empty = document.getElementById("roomEmpty");

        bg.src = src;
        bg.style.display = "block";
        empty.style.display = "none";
        hasRoomImage = true;
    }

    function addFurnitureToRoom(item) {
        if (!hasRoomImage) {
            alert("Please capture or upload room image first.");
            return;
        }

        const stage = document.getElementById("roomStage");

        const wrapper = document.createElement("div");
        wrapper.className = "placed-item";
        wrapper.dataset.rotation = "0";
        wrapper.dataset.scale = "1";
        wrapper.dataset.flip = "1";
        wrapper.dataset.name = item.name;
        wrapper.dataset.src = getFurnitureSrc(item);
        wrapper.id = "placedItem_" + (++itemCounter);
        wrapper.style.width = item.width + "px";
        wrapper.style.left = "38%";
        wrapper.style.top = "55%";
        wrapper.style.zIndex = ++highestZ;

        wrapper.innerHTML =
            "<img src='" + getFurnitureSrc(item) + "' alt='" + item.name + "' />" +
            "<span class='item-tag'>" + item.name + "</span>";

        stage.appendChild(wrapper);

        makeItemDraggable(wrapper);
        selectItem(wrapper);

        setStatus(item.name + " added. Tip: " + (item.tip || "Drag, resize and rotate for best placement."));
    }

    function makeItemDraggable(el) {
        let startX = 0;
        let startY = 0;
        let startLeft = 0;
        let startTop = 0;
        let dragging = false;

        el.addEventListener("pointerdown", function (e) {
            e.preventDefault();
            selectItem(el);

            dragging = true;
            el.setPointerCapture(e.pointerId);

            startX = e.clientX;
            startY = e.clientY;
            startLeft = el.offsetLeft;
            startTop = el.offsetTop;
        });

        el.addEventListener("pointermove", function (e) {
            if (!dragging) return;

            const dx = e.clientX - startX;
            const dy = e.clientY - startY;

            el.style.left = (startLeft + dx) + "px";
            el.style.top = (startTop + dy) + "px";
        });

        el.addEventListener("pointerup", function (e) {
            dragging = false;
            try { el.releasePointerCapture(e.pointerId); } catch { }
        });
    }

    function selectItem(el) {
        document.querySelectorAll(".placed-item").forEach(item => {
            item.classList.remove("selected");
        });

        selectedItem = el;
        selectedItem.classList.add("selected");
        selectedItem.style.zIndex = ++highestZ;

        setStatus("Selected: " + selectedItem.dataset.name);
    }

    document.addEventListener("click", function (e) {
        const stage = document.getElementById("roomStage");

        if (e.target === stage || e.target.id === "roomBackground") {
            document.querySelectorAll(".placed-item").forEach(item => item.classList.remove("selected"));
            selectedItem = null;
        }
    });

    function applyTransform(el) {
        const rotation = parseFloat(el.dataset.rotation || "0");
        const scale = parseFloat(el.dataset.scale || "1");
        const flip = parseFloat(el.dataset.flip || "1");

        el.style.transform = "scaleX(" + flip + ") scale(" + scale + ") rotate(" + rotation + "deg)";
    }

    function resizeSelected(factor) {
        if (!selectedItem) {
            alert("Please select a furniture item first.");
            return;
        }

        let scale = parseFloat(selectedItem.dataset.scale || "1");
        scale = Math.max(0.35, Math.min(3.2, scale * factor));
        selectedItem.dataset.scale = scale.toString();

        applyTransform(selectedItem);
        setStatus("Size updated.");
    }

    function rotateSelected(deg) {
        if (!selectedItem) {
            alert("Please select a furniture item first.");
            return;
        }

        let rotation = parseFloat(selectedItem.dataset.rotation || "0");
        rotation += deg;
        selectedItem.dataset.rotation = rotation.toString();

        applyTransform(selectedItem);
        setStatus("Rotation updated.");
    }

    function flipSelected() {
        if (!selectedItem) {
            alert("Please select a furniture item first.");
            return;
        }

        let flip = parseFloat(selectedItem.dataset.flip || "1");
        flip = flip === 1 ? -1 : 1;
        selectedItem.dataset.flip = flip.toString();

        applyTransform(selectedItem);
        setStatus("Furniture flipped.");
    }

    function deleteSelected() {
        if (!selectedItem) {
            alert("Please select a furniture item first.");
            return;
        }

        const name = selectedItem.dataset.name;
        selectedItem.remove();
        selectedItem = null;

        setStatus(name + " deleted.");
    }

    function duplicateSelected() {
        if (!selectedItem) {
            alert("Please select a furniture item first.");
            return;
        }

        const item = {
            name: selectedItem.dataset.name,
            file: selectedItem.dataset.src.split("/").pop(),
            width: selectedItem.offsetWidth
        };

        addFurnitureToRoom(item);

        if (selectedItem) {
            selectedItem.style.left = "45%";
            selectedItem.style.top = "58%";
        }
    }

    function bringForward() {
        if (!selectedItem) {
            alert("Please select a furniture item first.");
            return;
        }

        selectedItem.style.zIndex = ++highestZ;
        setStatus("Layer moved up.");
    }

    function sendBackward() {
        if (!selectedItem) {
            alert("Please select a furniture item first.");
            return;
        }

        let current = parseInt(selectedItem.style.zIndex || "5");
        selectedItem.style.zIndex = Math.max(3, current - 2);
        setStatus("Layer moved down.");
    }

    function centerSelected() {
        if (!selectedItem) {
            alert("Please select a furniture item first.");
            return;
        }

        selectedItem.style.left = "40%";
        selectedItem.style.top = "55%";
        setStatus("Furniture centered.");
    }

    function clearFurniture() {
        document.querySelectorAll(".placed-item").forEach(item => item.remove());
        selectedItem = null;
        setStatus("All furniture removed.");
    }

    function resetRoom() {
        clearFurniture();

        const bg = document.getElementById("roomBackground");
        const empty = document.getElementById("roomEmpty");
        const upload = document.getElementById("roomUploadInput");

        bg.src = "";
        bg.style.display = "none";
        empty.style.display = "block";
        upload.value = "";
        hasRoomImage = false;

        setStatus("Room reset. Add a new room image.");
    }

    async function exportDesignToDataUrl() {
        if (!hasRoomImage) {
            alert("Please add room image first.");
            return null;
        }

        const stage = document.getElementById("roomStage");
        const bg = document.getElementById("roomBackground");
        const canvas = document.getElementById("exportCanvas");
        const ctx = canvas.getContext("2d");

        canvas.width = stage.clientWidth;
        canvas.height = stage.clientHeight;

        ctx.fillStyle = "#eee6dc";
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        await drawImageObjectFitContain(ctx, bg, 0, 0, canvas.width, canvas.height);

        const items = Array.from(document.querySelectorAll(".placed-item"))
            .sort((a, b) => parseInt(a.style.zIndex || "0") - parseInt(b.style.zIndex || "0"));

        for (const item of items) {
            const img = item.querySelector("img");
            await drawPlacedItem(ctx, item, img);
        }

        return canvas.toDataURL("image/png");
    }

    function loadImage(src) {
        return new Promise((resolve, reject) => {
            const img = new Image();
            img.onload = () => resolve(img);
            img.onerror = reject;
            img.src = src;
        });
    }

    async function drawImageObjectFitContain(ctx, imgElement, x, y, width, height) {
        const img = await loadImage(imgElement.src);

        const imageRatio = img.width / img.height;
        const boxRatio = width / height;

        let drawWidth = width;
        let drawHeight = height;
        let dx = x;
        let dy = y;

        if (imageRatio > boxRatio) {
            drawHeight = width / imageRatio;
            dy = y + (height - drawHeight) / 2;
        } else {
            drawWidth = height * imageRatio;
            dx = x + (width - drawWidth) / 2;
        }

        ctx.drawImage(img, dx, dy, drawWidth, drawHeight);
    }

    async function drawPlacedItem(ctx, item, imgElement) {
        const img = await loadImage(imgElement.src);

        const rect = item.getBoundingClientRect();
        const stageRect = document.getElementById("roomStage").getBoundingClientRect();

        const x = rect.left - stageRect.left;
        const y = rect.top - stageRect.top;
        const width = rect.width;
        const height = rect.height;

        const rotation = parseFloat(item.dataset.rotation || "0") * Math.PI / 180;
        const flip = parseFloat(item.dataset.flip || "1");

        ctx.save();
        ctx.translate(x + width / 2, y + height / 2);
        ctx.rotate(rotation);
        ctx.scale(flip, 1);
        ctx.drawImage(img, -width / 2, -height / 2, width, height);
        ctx.restore();
    }

    async function downloadFinalDesign() {
        const dataUrl = await exportDesignToDataUrl();

        if (!dataUrl) return;

        const link = document.createElement("a");
        link.href = dataUrl;
        link.download = "ar-room-furniture-design.png";
        link.click();

        setStatus("Final room design downloaded.");
    }

    async function saveFinalDesign() {
        const dataUrl = await exportDesignToDataUrl();

        if (!dataUrl) return;

        const formData = new FormData();
        formData.append("designImage", dataUrl);
        formData.append("selectedFurnitureName", "Multi Furniture AR Room Design");
        formData.append("selectedFurnitureImage", "");
        formData.append("aiSuggestion", "Room designed using camera/gallery image and multiple draggable furniture placement.");

        try {
            const response = await fetch("/Home/SaveRoomDesign", {
                method: "POST",
                body: formData
            });

            const result = await response.json();

            if (result.requiresLogin) {
                alert("Please login first to save your room design.");
                window.location.href = "/Home/Login";
                return;
            }

            alert(result.message || "Design saved.");
            setStatus(result.message || "Design saved.");
        } catch (error) {
            alert("Design could not be saved. Please download it instead.");
            setStatus("Save failed. You can still download the design.");
        }
    }
</script>
