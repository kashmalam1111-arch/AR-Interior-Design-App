    function getAutoFurnitureForRoom(roomType) {
        const key = roomType.toLowerCase();

        if (key.includes("kitchen")) {
            return ["Wardrobe", "Side Table", "Plant", "Table Lamp"];
        }

        if (key.includes("bath")) {
            return ["Wardrobe", "Plant", "Table Lamp", "Side Table"];
        }

        if (key.includes("living")) {
            return ["Sofa", "Coffee Table", "Rug", "Plant", "Floor Lamp"];
        }

        if (key.includes("tv")) {
            return ["Sofa", "Coffee Table", "Rug", "Floor Lamp", "Side Table"];
        }

        if (key.includes("balcony")) {
            return ["Chair", "Side Table", "Plant", "Rug", "Table Lamp"];
        }

        if (key.includes("garage")) {
            return ["Wardrobe", "Bookshelf", "Side Table", "Table Lamp"];
        }

        if (key.includes("dining")) {
            return ["Coffee Table", "Chair", "Chair", "Rug", "Floor Lamp"];
        }

        return ["Bed", "Side Table", "Table Lamp", "Rug", "Wardrobe"];
    }

