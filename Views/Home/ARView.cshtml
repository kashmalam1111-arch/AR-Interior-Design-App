    function getAISuggestionData(roomType, style, budget, prompt) {
        const key = roomType.toLowerCase();

        let layout = [];
        let furniture = [];
        let lighting = [];
        let decor = [];

        if (key.includes("kitchen")) {
            layout = ["Use a clean working triangle between sink, cooking area and preparation counter.", "Keep cabinets on vertical walls to save space.", "Keep the center area open for movement."];
            furniture = ["Base cabinets", "Wall cabinets", "Kitchen counter", "Sink area", "Small breakfast corner if space allows"];
            lighting = ["Task light under cabinets", "Ceiling light for general brightness", "Warm strip light for premium look"];
            decor = ["Matte backsplash", "Neutral counter accessories", "Small indoor plant"];
        } else if (key.includes("bath")) {
            layout = ["Place vanity near entrance side.", "Keep shower zone separate with glass partition concept.", "Use wall storage to avoid clutter."];
            furniture = ["Vanity unit", "Mirror", "Tall storage cabinet", "Shower screen", "Towel shelf"];
            lighting = ["Mirror light", "Ceiling light", "Soft warm accent light"];
            decor = ["Large mirror", "Neutral tiles", "Small plant", "Gold/black fixtures according to style"];
        } else if (key.includes("dining")) {
            layout = ["Place dining table in center with walking space around it.", "Use side wall for console or crockery unit.", "Keep light centered above table."];
            furniture = ["Dining table", "Dining chairs", "Console table", "Pendant light", "Rug if space allows"];
            lighting = ["Pendant light above table", "Soft wall light", "Warm ambient ceiling light"];
            decor = ["Centerpiece", "Wall art", "Crockery display", "Neutral rug"];
        } else if (key.includes("balcony")) {
            layout = ["Use compact seating on one side.", "Keep plants on corners to save floor area.", "Use small table in center."];
            furniture = ["Outdoor chair", "Small coffee table", "Planters", "Outdoor rug", "Wall light"];
            lighting = ["Warm string lights", "Wall mounted outdoor light", "Small lantern"];
            decor = ["Plants", "Outdoor cushions", "Small rug", "Minimal wall decor"];
        } else if (key.includes("tv")) {
            layout = ["Place sofa facing TV wall.", "Keep media console below TV.", "Use rug to define seating zone."];
            furniture = ["Sofa", "TV console", "Coffee table", "Rug", "Floor lamp", "Side table"];
            lighting = ["Backlight behind TV", "Floor lamp near sofa", "Warm ceiling light"];
            decor = ["Wall panels", "Plant", "Minimal shelves", "Cushions"];
        } else if (key.includes("living")) {
            layout = ["Place sofa as main seating focus.", "Use coffee table in center.", "Keep one accent chair for balance."];
            furniture = ["Sofa", "Coffee table", "Accent chair", "Rug", "Plant", "Floor lamp"];
            lighting = ["Floor lamp", "Warm ambient light", "Accent light for wall decor"];
            decor = ["Cushions", "Wall art", "Plant", "Decor tray"];
        } else if (key.includes("garage")) {
            layout = ["Keep parking area clear in center.", "Use wall-mounted storage to save floor space.", "Create separate tool/storage zone on one side."];
            furniture = ["Storage cabinet", "Wall shelves", "Tool rack", "Utility table", "Bright ceiling light"];
            lighting = ["Bright ceiling light", "Task light near workbench", "Motion sensor light if required"];
            decor = ["Grey wall paint", "Durable flooring", "Labelled storage boxes", "Safety corner"];
        } else {
            layout = ["Place bed on main feature wall.", "Keep side tables on both sides if space allows.", "Use wardrobe on side wall without blocking movement."];
            furniture = ["Bed", "Side tables", "Wardrobe", "Rug", "Table lamps", "Study/vanity corner if space allows"];
            lighting = ["Warm bedside lamps", "Soft ceiling light", "Accent light behind headboard"];
            decor = ["Cream wall paint", "Curtains", "Minimal wall art", "Neutral rug", "Storage baskets"];
        }

        const colors = getPaletteForStyle(style);

        return { layout, furniture, lighting, decor, colors };
    }

    function getPaletteForStyle(style) {
        const s = style.toLowerCase();

        if (s.includes("luxury")) return ["#efe2cf", "#b69261", "#2f2f2f", "#ffffff"];
        if (s.includes("modern")) return ["#e8edf1", "#667985", "#ffffff", "#222831"];
        if (s.includes("minimal")) return ["#f4f1ea", "#c9b8a6", "#ffffff", "#3b3b3b"];
        if (s.includes("classic")) return ["#efe6d8", "#8c6a4a", "#ffffff", "#2c2118"];
        if (s.includes("cozy")) return ["#f0ddc9", "#b88763", "#fff7ef", "#5f4634"];
        return ["#e9e1d2", "#9b7b4f", "#ffffff", "#232323"];
    }

    function paletteHtml(colors) {
        return "<div class='palette-row'>" + colors.map(c => "<span class='palette-dot' style='background:" + c + "'></span>").join("") + "</div>";
    }

    function listHtml(items) {
        return "<ul>" + items.map(x => "<li>" + x + "</li>").join("") + "</ul>";
    }

    function addChatMessage(text, type) {
        const chat = document.getElementById("chatWindow");
        const msg = document.createElement("div");
        msg.className = type === "bot" ? "chat-msg bot designer" : "chat-msg user";
        msg.innerText = text;
        chat.appendChild(msg);
        chat.scrollTop = chat.scrollHeight;
    }


