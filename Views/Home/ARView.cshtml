    function normalizeText(value) {
        return (value || "").toLowerCase();
    }

    function customDetectRoom(message) {
        const m = normalizeText(message);

        if (m.includes("kitchen") || m.includes("kichen") || m.includes("kitten")) return "Kitchen";
        if (m.includes("bathroom") || m.includes("washroom") || m.includes("toilet")) return "Bathroom";
        if (m.includes("living")) return "Living Room";
        if (m.includes("tv") || m.includes("lounge")) return "TV Lounge";
        if (m.includes("balcony")) return "Balcony";
        if (m.includes("garage") || m.includes("graduge")) return "Garage";
        if (m.includes("dining")) return "Dining Room";
        if (m.includes("bedroom") || m.includes("bed room") || m.includes("bed")) return "Bedroom";
        if (m.includes("study") || m.includes("desk") || (m.includes("table") && m.includes("chair"))) return "Study Corner";

        return "General Room";
    }

    function customDetectStyle(message) {
        const m = normalizeText(message);

        if (m.includes("luxury") || m.includes("royal") || m.includes("premium")) return "Luxury";
        if (m.includes("modern")) return "Modern";
        if (m.includes("minimal") || m.includes("simple")) return "Minimal";
        if (m.includes("classic")) return "Classic";
        if (m.includes("cozy") || m.includes("warm")) return "Cozy";

        const selected = document.getElementById("aiStyle");
        return selected ? selected.value : "Modern";
    }

    function customDetectBudget(message) {
        const m = normalizeText(message);

        if (m.includes("low") || m.includes("cheap") || m.includes("budget") || m.includes("kam")) return "Low Budget";
        if (m.includes("medium")) return "Medium Budget";
        if (m.includes("premium") || m.includes("luxury") || m.includes("high")) return "Premium Budget";

        const selected = document.getElementById("aiBudget");
        return selected ? selected.value : "Medium Budget";
    }

    function customDetectNeeds(message) {
        const m = normalizeText(message);
        const needs = [];

        if (m.includes("storage") || m.includes("wardrobe") || m.includes("almari") || m.includes("shelf")) needs.push("extra storage");
        if (m.includes("light") || m.includes("lighting") || m.includes("warm")) needs.push("warm lighting");
        if (m.includes("color") || m.includes("wall") || m.includes("cream") || m.includes("paint")) needs.push("wall color palette");
        if (m.includes("small") || m.includes("space") || m.includes("compact")) needs.push("space saving layout");
        if (m.includes("luxury") || m.includes("premium")) needs.push("luxury finishing");
        if (m.includes("sofa")) needs.push("sofa placement");
        if (m.includes("bed")) needs.push("bed placement");
        if (m.includes("table")) needs.push("table placement");
        if (m.includes("plant")) needs.push("decor plants");

        if (needs.length === 0) needs.push("balanced room design");

        return needs;
    }

