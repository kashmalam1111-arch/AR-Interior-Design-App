    function detectRoomFromText(message) {
        const m = message.toLowerCase();

        if (m.includes("kitchen")) return "Kitchen";
        if (m.includes("bathroom") || m.includes("washroom")) return "Bathroom";
        if (m.includes("living")) return "Living Room";
        if (m.includes("tv")) return "TV Lounge";
        if (m.includes("balcony")) return "Balcony";
        if (m.includes("garage")) return "Garage";
        if (m.includes("dining")) return "Dining Room";
        if (m.includes("bedroom") || m.includes("bed")) return "Bedroom";

        const select = document.getElementById("aiRoomType");
        return select ? select.value : "Room";
    }

    function detectStyleFromText(message) {
        const m = message.toLowerCase();

        if (m.includes("luxury") || m.includes("premium")) return "Luxury";
        if (m.includes("minimal")) return "Minimal";
        if (m.includes("classic")) return "Classic";
        if (m.includes("cozy") || m.includes("warm")) return "Cozy";
        if (m.includes("modern")) return "Modern";

        const select = document.getElementById("aiStyle");
        return select ? select.value : "Modern";
    }

    function detectBudgetFromText(message) {
        const m = message.toLowerCase();

        if (m.includes("low") || m.includes("cheap") || m.includes("budget")) return "Low/Medium Budget";
        if (m.includes("luxury") || m.includes("premium")) return "Premium Budget";

        const select = document.getElementById("aiBudget");
        return select ? select.value : "Medium Budget";
    }

    function mentionedFurniture(message) {
        const m = message.toLowerCase();
        const list = [];

        if (m.includes("bed")) list.push("bed");
        if (m.includes("wardrobe") || m.includes("almari")) list.push("wardrobe");
        if (m.includes("sofa")) list.push("sofa");
        if (m.includes("chair")) list.push("chair");
        if (m.includes("table")) list.push("table");
        if (m.includes("lamp") || m.includes("light")) list.push("lamp/lighting");
        if (m.includes("rug") || m.includes("carpet")) list.push("rug");
        if (m.includes("plant")) list.push("plant");
        if (m.includes("storage") || m.includes("shelf")) list.push("storage shelves");

        return list.length ? list.join(", ") : "main furniture according to selected room";
    }

