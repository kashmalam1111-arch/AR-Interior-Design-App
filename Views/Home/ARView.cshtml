        const autoItems = getAutoFurnitureForRoom(roomType);

        clearFurniture();

        let offset = 0;

        autoItems.forEach(itemName => {
            const item = furnitureItems.find(f => f.name === itemName);

            if (item) {
                addFurnitureToRoom(item);

                if (selectedItem) {
